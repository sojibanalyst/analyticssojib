# Copy to .env.local and fill in. NAMES ONLY in this file — never values.
# Real values live in Vercel project env vars and GitHub Actions secrets.

# --- Google Tag Manager ------------------------------------------------------
# Leave empty and the site renders no GTM script and no noscript iframe at all.
# GTM-XXXXXXX
NEXT_PUBLIC_GTM_ID=

# --- Supabase ----------------------------------------------------------------
# Project URL and publishable key. Both are safe in the browser: they are
# powerless without a session because every table is behind RLS.
# https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# sb_publishable_...
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key. Bypasses RLS completely.
#   - NEVER prefix this NEXT_PUBLIC_
#   - NEVER import it into a client component
#   - NEVER commit it
# Supabase dashboard → Project Settings → API → service_role → Reveal,
# then paste into Vercel → Settings → Environment Variables (Production).
# CI greps .next/static for this value and fails the build if it appears.
SUPABASE_SERVICE_ROLE_KEY=

# --- Destination credentials (FALLBACK ONLY) ---------------------------------
# Set these in the console instead: /admin/destinations stores each one
# encrypted in Supabase Vault and lets you rotate it without a redeploy.
#
# These are read only when the database has no value for that destination.
# They exist so a deployment keeps working if nobody has opened the console
# yet, and so an existing setup survives the move.
#
# There is deliberately no ENCRYPTION_KEY here: Vault holds its key outside
# the database, so no key material passes through this application.
GA4_API_SECRET=
META_CAPI_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
TIKTOK_ACCESS_TOKEN=
